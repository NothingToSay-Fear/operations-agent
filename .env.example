# 复制为 .env 后按需填写；本地 Python 默认使用 backend/data 下的 SQLite 数据库。
# 修改配置后需重启对应服务；Docker 配置通过 Compose 创建或重建容器后生效。

# 对话模型接口类型：openai、anthropic 或 ollama。
# 兼容 OpenAI 协议的服务（例如 DeepSeek）也填写 openai，并设置下方服务地址。
LLM_PROVIDER=openai

# 服务端提供的模型标识，用于规划、执行决策、评估和记忆维护。
# 留空时不启动模型分析；资料管理和显式记忆确认仍可使用。
LLM_MODEL=

# 模型服务的 API 密钥；openai 和 anthropic 接口需要填写，ollama 可留空。
# 真实密钥请仅保存在本地 .env，不要放入示例文件或提交到版本库。
LLM_API_KEY=

# 模型 API 服务地址，按供应商的兼容接口地址填写。
# 留空时 openai / anthropic 使用各自 SDK 默认地址，ollama 使用 http://localhost:11434。
# Docker 内的 localhost 指容器自身；访问宿主机 Ollama 时通常使用 http://host.docker.internal:11434。
LLM_BASE_URL=

# 单次模型调用超时时间，单位为秒；复杂规划和最终评估可能需要更长响应时间。
# Compose 会把此值同时传给 API 和独立 Worker，默认 90 秒。
LLM_TIMEOUT=90

# 模型采样温度：较低时输出通常更稳定，较高时变化更多；支持范围取决于模型。
# 当前 Compose 未透传此项：本地 Python 读取此值，Docker 使用代码默认值 0.2。
LLM_TEMPERATURE=0.2

# 单次模型上下文中保留的近期消息条数；默认 12 条，约等于六轮问答。
# 更早消息仍完整保存在数据库，并在达到阈值后进入滚动摘要或当前任务历史召回。
MEMORY_RECENT_TURN_LIMIT=12

# 单条消息进入近期窗口时允许保留的最大字符数；数据库中的完整原文不受此值影响。
MEMORY_TURN_CHAR_LIMIT=2000

# 任务记忆、近期消息、观察和长期记忆共同使用的上下文字符预算。
MEMORY_CONTEXT_CHAR_BUDGET=24000

# 近期窗口与摘要达到此字符量后安排后台压缩，压缩由真实对话模型完成。
MEMORY_COMPACT_THRESHOLD=18000

# 单个总体步骤最多可同时委派的临时子 Agent 数量；默认 3，简单问题不会触发委派。
MAX_SUBTASKS=3

# 每个子 Agent 最多可调用模型和只读工具的次数；两者都从当前用户轮次的总预算中扣除。
SUBTASK_MAX_MODEL_CALLS=4
SUBTASK_MAX_TOOL_CALLS=3

# 单条用户消息可用的模型调用总次数，包含主 Agent 和子 Agent
MAX_MODEL_CALLS=30
# 单条用户消息可用的工具调用总次数，包含主 Agent 和子 Agent
MAX_TOOL_CALLS=30
# 单轮最多重新规划次数、活跃执行秒数与单步骤工具上限
MAX_REPLANS=5
MAX_ACTIVE_SECONDS=300
MAX_STEP_TOOLS=6

# 子 Agent 的独立上下文字符预算；只包含任务单、必要约束、少量近期对话和自身观察。
SUBTASK_CONTEXT_CHAR_BUDGET=8000

# 主 Agent 每次执行决策最多携带的最近工具观察数量；完整证据仍可按 ID 分页读取。
MAIN_CONTEXT_OBSERVATION_LIMIT=10
# 主 Agent 注入工具观测的最大字符数，超过时优先保留最近的可审计摘要
MAIN_CONTEXT_OBSERVATION_CHAR_BUDGET=7000

# 本地向量模型目录，用于资料、任务历史和长期记忆的语义检索；当前索引要求 512 维。
# 相对路径以 backend/ 为基准；请先准备模型权重，请求期间不会自动下载。
# Docker 不读取此路径值，固定使用根目录 models/ 挂载后的 /models/bge-small-zh-v1.5。
EMBEDDING_MODEL_PATH=../models/bge-small-zh-v1.5

# 本地精排模型目录，用于对召回片段重新打分、筛除低相关内容。
# 相对路径以 backend/ 为基准；未配置或模型不可用时会显示降级检索状态。
# Docker 不读取此路径值，固定使用根目录 models/ 挂载后的 /models/bge-reranker-base。
RERANKER_MODEL_PATH=../models/bge-reranker-base

# Docker 数据库管理员 postgres 的初始化密码，启动 Compose 前必填。
# 四个数据库密码应分别使用不同的随机字母数字；本地默认 SQLite 无需填写。
# 已有数据库数据卷时，修改这些变量不会自动修改数据库内已有账号的密码。
POSTGRES_PASSWORD=

# Docker 应用数据库账号 operations_app 的密码，启动 Compose 前必填。
# 用于保存用户、任务、成果、资料索引、公共资料权限和记忆。
APP_DB_PASSWORD=

# 系统启动时自动创建或校正的管理员用户名；管理员可以上传和管理公共资料。
ADMIN_USERNAME=admin

# 管理员登录密码；部署到非本地环境前应替换为高强度密码。
ADMIN_PASSWORD=adminadmin

# Docker 经营数据库所有者 commerce_owner 的密码，启动 Compose 前必填。
# 只交给模拟数据初始化服务使用，用于建表和生成经营数据。
COMMERCE_OWNER_PASSWORD=

# Docker 经营数据库只读账号 commerce_reader 的密码，启动 Compose 前必填。
# API 和 Worker 通过此账号查询经营数据，没有业务数据写入权限。
COMMERCE_READER_PASSWORD=

# 首次初始化模拟数据时覆盖的历史天数，默认 180 天。
# 以下 SEED 参数仅作用于新数据集；启动时检测到已有数据会跳过生成，不自动覆盖。
SEED_DAYS=180

# 模拟商品规格（SKU）的数量，默认 200，用于生成商品及关联经营数据。
SEED_SKUS=200

# 模拟订单数量的生成目标，默认 50000；实际数量以生成报告为准。
SEED_ORDERS=50000

# 模拟经营情境：baseline（基准）、traffic_drop（流量下降）、stockout（缺货）、
# refund_wave（退款增加）、promotion_margin（促销毛利变化）、supply_delay（供应延迟）、mixed（混合）。
SEED_SCENARIO=mixed

# 允许浏览器跨域访问 API 的前端来源，多个地址用英文逗号分隔。
# 每项包含协议、域名和端口，不包含页面路径；更换前端端口或域名时同步修改。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 是否仅通过 HTTPS 发送登录 Cookie：本地 HTTP 开发使用 false，HTTPS 部署使用 true。
# 在 HTTP 环境设为 true 会导致浏览器无法正常携带登录 Cookie。
COOKIE_SECURE=false

# Docker API 映射到宿主机的端口，默认 8000，仅绑定 127.0.0.1。
# 此项不会改变本地 uvicorn 启动端口；本地端口通过启动命令指定。
API_PORT=8000

# Docker 前端映射到宿主机的端口，默认 5173，仅绑定 127.0.0.1。
# 此项不会改变本地 Vite 开发服务端口；修改后需同步调整 CORS_ORIGINS。
FRONTEND_PORT=5173

# Adminer 数据库查看页面端口，默认 8081，仅绑定 127.0.0.1。
# 仅供本机开发和排障使用，不应暴露到公网。
ADMINER_PORT=8081

# 可选：每一百万输入 Token 的单价，用于估算调用成本；启用时移除下一行开头的注释符并填写数字。
# 输入与输出单价必须使用相同货币单位；两项未完整配置时成本显示为未知。
# 当前 Compose 未透传单价配置，仅本地 Python 直接读取。
# INPUT_PRICE_PER_MILLION=

# 可选：每一百万输出 Token 的单价；启用时移除下一行开头的注释符并填写数字。
# 只用于成本估算，不影响供应商实际计费；币种与输入单价保持一致。
# 当前 Compose 未透传单价配置，仅本地 Python 直接读取。
# OUTPUT_PRICE_PER_MILLION=
